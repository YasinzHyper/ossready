{
  "name": "ossready",
  "version": "0.1.0",
  "description": "Scaffold production-ready public GitHub repos in one command",
  "type": "module",
  "bin": {
    "ossready": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "scaffold",
    "oss",
    "github",
    "boilerplate",
    "typescript",
    "open-source"
  ],
  "author": "Mohammed Yasin Zuhayr (YasinzHyper)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YasinzHyper/ossready.git"
  },
  "bugs": {
    "url": "https://github.com/YasinzHyper/ossready/issues"
  },
  "homepage": "https://github.com/YasinzHyper/ossready#readme",
  "dependencies": {
    "cac": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
